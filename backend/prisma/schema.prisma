generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//
// Waasha Production Foundation — MySQL 8.x
// Blueprint: docs/WAASHA_PRODUCTION_BLUEPRINT_MASTER.md Document 02 Database Architecture
// Vertical slice: radius discovery (10/15/20) requires provider coverage + admin_settings
// Full foundation included per PHASE 2 — not radius-only.
//

// ── Auth / Identity ─────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  uuid            String    @unique @default(uuid())
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String?   @map("password_hash")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  roles            UserRole[]
  customerProfile  CustomerProfile?
  providerProfile  ProviderProfile?
  auditLogs        AuditLog[] @relation("AuditActor")

  @@map("users")
  @@index([status])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DELETED
  PENDING_VERIFICATION
  LOCKED
  DEACTIVATED
}

model Role {
  id        String     @id @default(cuid())
  code      String     @unique // CUSTOMER, PROVIDER, TRAINING_CENTRE, ADMIN
  name      String
  createdAt DateTime   @default(now()) @map("created_at")
  users     UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
  @@index([userId])
  @@index([roleId])
}

// ── Customer ────────────────────────────────────────────────────

model CustomerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  firstName        String?  @map("first_name")
  lastName         String?  @map("last_name")
  displayName      String?  @map("display_name")
  profileImageUrl  String?  @map("profile_image_url")
  defaultLocationId String? @map("default_location_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("customer_profiles")
}

// ── Provider Tiers & Profiles ───────────────────────────────────

model ProviderTier {
  id          String   @id @default(cuid())
  code        String   @unique // T1, T2, T3
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  providers ProviderProfile[]

  @@map("provider_tiers")
}

model ProviderProfile {
  id                     String             @id @default(cuid())
  userId                 String             @unique @map("user_id")
  tierId                 String             @map("tier_id")
  providerType           ProviderType       @default(INDIVIDUAL) @map("provider_type")
  displayName            String?            @map("display_name")
  bio                    String?            @db.Text
  profileImageUrl        String?            @map("profile_image_url")
  // Slice 11 — optional link to the finalized media asset behind
  // profileImageUrl. Null preserves all pre-existing Slice 10 references.
  profileMediaAssetId    String?            @map("profile_media_asset_id")
  experienceSummary      String?            @map("experience_summary") @db.Text
  customRequestsEnabled  Boolean            @default(false) @map("custom_requests_enabled")
  verificationStatus     VerificationStatus @default(UNVERIFIED) @map("verification_status")
  // Radius vertical slice — service coverage
  coverageRadiusKm       Int                @default(10) @map("coverage_radius_km")
  // Phase 1.5 — Cash acceptance & Student verification (financial architecture)
  acceptCash             Boolean            @default(true) @map("accept_cash")
  isStudent              Boolean            @default(false) @map("is_student")
  studentVerificationStatus VerificationStatus @default(UNVERIFIED) @map("student_verification_status")
  timezone               String             @default("Africa/Johannesburg") @map("timezone")
  status                 ProviderStatus     @default(ACTIVE)
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  deletedAt              DateTime?          @map("deleted_at")

  tier      ProviderTier      @relation(fields: [tierId], references: [id])
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations ProviderLocation[]
  services  Service[]         // provider-owned services (provider_id)
  bookings  Booking[]         @relation("BookingProvider")
  assignedBookings Booking[]  @relation("BookingAssignedProvider")
  cashAccount ProviderCashAccount?
  cashLedgerEntries CashLedgerEntry[]

  @@map("provider_profiles")
  @@index([tierId])
  @@index([status])
  @@index([verificationStatus])
  @@index([coverageRadiusKm])
  @@index([acceptCash])
  @@index([isStudent])
}

enum ProviderType {
  INDIVIDUAL
  TEAM
  BUSINESS
}

enum ProviderStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  PENDING_REVIEW
  DRAFT
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
  SUSPENDED
}

// ── Provider Locations (geospatial) ─────────────────────────────

model ProviderLocation {
  id           String       @id @default(cuid())
  providerId   String       @map("provider_id")
  locationType LocationType @default(FIXED) @map("location_type")
  label        String?
  addressLine1 String?      @map("address_line_1")
  city         String?
  province     String?
  postalCode   String?      @map("postal_code")
  country      String?      @default("ZA")
  latitude     Float
  longitude    Float
  isPrimary    Boolean      @default(false) @map("is_primary")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_locations")
  @@index([providerId])
  @@index([latitude, longitude])
  @@index([isPrimary])
}

// For T3 business units
model BusinessLocation {
  id             String   @id @default(cuid())
  businessUnitId String   @map("business_unit_id")
  label          String?
  addressLine1   String?  @map("address_line_1")
  city           String?
  province       String?
  postalCode     String?  @map("postal_code")
  country        String?  @default("ZA")
  latitude       Float
  longitude      Float
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@map("business_locations")
  @@index([businessUnitId])
  @@index([latitude, longitude])
}

enum LocationType {
  FIXED
  LIVE
}

// ── Categories ──────────────────────────────────────────────────

model ServiceCategory {
  id        String   @id @default(cuid())
  code      String   @unique // BARBERS, HAIR_SALONS_STYLISTS, etc.
  name      String
  description String? @db.Text
  icon      String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  services              Service[]
  businessUnitCategories BusinessUnitCategory[]

  @@map("service_categories")
}

// ── Services ────────────────────────────────────────────────────

model Service {
  id                     String      @id @default(cuid())
  uuid                   String      @unique @default(uuid())
  serviceCategoryId      String      @map("service_category_id")
  providerId             String?     @map("provider_id")
  businessUnitId         String?     @map("business_unit_id")
  name                   String
  description            String?     @db.Text
  price                  Decimal     @db.Decimal(12, 2)
  currency               String      @default("ZAR")
  durationMinutes        Int         @map("duration_minutes")
  serviceMode            ServiceMode @default(BOTH) @map("service_mode")
  customRequestSupported Boolean     @default(false) @map("custom_request_supported")
  status                 ServiceStatus @default(ACTIVE)
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  deletedAt              DateTime?   @map("deleted_at")

  category     ServiceCategory @relation(fields: [serviceCategoryId], references: [id])
  provider     ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  businessUnit BusinessUnit?   @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  images       ServiceImage[]

  @@map("services")
  @@index([providerId])
  @@index([businessUnitId])
  @@index([serviceCategoryId])
  @@index([status])
}

enum ServiceMode {
  PROVIDER_LOCATION
  CUSTOMER_LOCATION
  BOTH
}

enum ServiceStatus {
  ACTIVE
  PAUSED
  DRAFT
  SUSPENDED
}

model ServiceImage {
  id         String   @id @default(cuid())
  serviceId  String   @map("service_id")
  imageUrl   String   @map("image_url")
  storageKey String?  @map("storage_key")
  // Slice 11 — optional link to a finalized media asset. Null preserves all
  // pre-existing Slice 9 references. Historical booking snapshots never
  // depend on this link (booking_items carry their own copies).
  mediaAssetId String? @map("media_asset_id")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_images")
  @@index([serviceId])
  @@index([mediaAssetId])
}

// ── Teams & Businesses (tenant isolation) ───────────────────────

model Team {
  id              String   @id @default(cuid())
  uuid            String   @unique @default(uuid())
  ownerProviderId String   @map("owner_provider_id")
  name            String
  description     String?  @db.Text
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  members     TeamMember[]
  invitations TeamInvitation[]

  @@map("teams")
  @@index([ownerProviderId])
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String   @map("team_id")
  providerId String   @map("provider_id")
  role       String   @default("PROVIDER") // OWNER, MANAGER, PROVIDER
  status     String   @default("ACTIVE")
  joinedAt   DateTime @default(now()) @map("joined_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, providerId])
  @@map("team_members")
}

model Business {
  id                String   @id @default(cuid())
  uuid              String   @unique @default(uuid())
  ownerProviderId   String   @map("owner_provider_id")
  legalName         String?  @map("legal_name")
  displayName       String   @map("display_name")
  description       String?  @db.Text
  status            String   @default("ACTIVE")
  verificationStatus String  @default("UNVERIFIED") @map("verification_status")
  acceptCash        Boolean  @default(true) @map("accept_cash")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  units BusinessUnit[]
  staff BusinessStaff[]
  staffInvitations BusinessStaffInvitation[]

  @@map("businesses")
  @@index([ownerProviderId])
  @@index([acceptCash])
}

model BusinessUnit {
  id                String   @id @default(cuid())
  uuid              String   @unique @default(uuid())
  businessId        String   @map("business_id")
  name              String
  description       String?  @db.Text
  serviceCategoryId String?  @map("service_category_id")
  status            String   @default("ACTIVE")
  // coverage for business unit as well — used for marketplace
  coverageRadiusKm  Int      @default(10) @map("coverage_radius_km")
  acceptCash        Boolean  @default(true) @map("accept_cash")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  business   Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categories BusinessUnitCategory[]
  locations  BusinessLocation[]
  services   Service[]
  staffInvitations BusinessStaffInvitation[]

  @@map("business_units")
  @@index([businessId])
  @@index([coverageRadiusKm])
  @@index([acceptCash])
}

model BusinessUnitCategory {
  id                String @id @default(cuid())
  businessUnitId    String @map("business_unit_id")
  serviceCategoryId String @map("service_category_id")

  businessUnit BusinessUnit    @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  category     ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@unique([businessUnitId, serviceCategoryId])
  @@map("business_unit_categories")
}

model BusinessStaff {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  businessUnitId String?  @map("business_unit_id")
  providerId     String   @map("provider_id")
  role           String   @default("STAFF") // OWNER, MANAGER, STAFF
  status         String   @default("ACTIVE")
  joinedAt       DateTime @default(now()) @map("joined_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_staff")
  @@index([businessId])
  @@index([providerId])
}

// ── Slice 15 — T2/T3 invitations (secure, scoped, expiring, single-use) ──
// Tokens are random 256-bit values; only the SHA-256 hash is persisted.
// The raw token is returned once at creation and never logged. Invitations
// are scoped to exactly one team or business(+unit); acceptance verifies
// the session provider belongs to the invitee identity — cross-business
// acceptance is impossible. No vendor SDK: notification hooks use the
// existing provider-agnostic notification abstraction.

model TeamInvitation {
  id                String    @id @default(cuid())
  teamId            String    @map("team_id")
  invitedProviderId String?   @map("invited_provider_id")
  invitedEmail      String?   @map("invited_email")
  role              String    @default("PROVIDER") // MANAGER | PROVIDER
  tokenHash         String    @unique @map("token_hash")
  status            String    @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  expiresAt         DateTime  @map("expires_at")
  createdBy         String    @map("created_by")
  acceptedAt        DateTime? @map("accepted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_invitations")
  @@index([teamId, status])
  @@index([invitedProviderId])
  @@index([status, expiresAt])
}

model BusinessStaffInvitation {
  id                String    @id @default(cuid())
  businessId        String    @map("business_id")
  businessUnitId    String?   @map("business_unit_id")
  invitedProviderId String?   @map("invited_provider_id")
  invitedEmail      String?   @map("invited_email")
  role              String    @default("STAFF") // MANAGER | STAFF
  tokenHash         String    @unique @map("token_hash")
  status            String    @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  expiresAt         DateTime  @map("expires_at")
  createdBy         String    @map("created_by")
  acceptedAt        DateTime? @map("accepted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@map("business_staff_invitations")
  @@index([businessId, status])
  @@index([businessUnitId])
  @@index([invitedProviderId])
  @@index([status, expiresAt])
}

// ── Availability ────────────────────────────────────────────────

model AvailabilityRule {
  id             String   @id @default(cuid())
  providerId     String?  @map("provider_id")
  businessUnitId String?  @map("business_unit_id")
  dayOfWeek      Int      @map("day_of_week")
  startTime      String   @map("start_time") // HH:mm
  endTime        String   @map("end_time")
  timezone       String   @default("Africa/Johannesburg")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("availability_rules")
  @@index([providerId])
  @@index([businessUnitId])
}

model AvailabilityException {
  id             String   @id @default(cuid())
  providerId     String?  @map("provider_id")
  businessUnitId String?  @map("business_unit_id")
  date           DateTime @db.Date
  startTime      String?  @map("start_time")
  endTime        String?  @map("end_time")
  type           String   // UNAVAILABLE, CUSTOM_HOURS
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("availability_exceptions")
}

// ── Bookings (historical snapshot) ──────────────────────────────

model Booking {
  id                  String        @id @default(cuid())
  uuid                String        @unique @default(uuid())
  customerId          String        @map("customer_id")
  providerId          String?       @map("provider_id")
  businessUnitId      String?       @map("business_unit_id")
  serviceId           String?       @map("service_id")
  assignedProviderId  String?       @map("assigned_provider_id")
  bookingType         BookingType   @default(STANDARD) @map("booking_type")
  serviceLocationType String        @default("PROVIDER") @map("service_location_type")
  scheduledStart      DateTime      @map("scheduled_start")
  scheduledEnd        DateTime      @map("scheduled_end")
  timezone            String        @default("Africa/Johannesburg")
  status              BookingStatus @default(PENDING)
  currency            String        @default("ZAR")
  subtotal            Decimal       @db.Decimal(12, 2)
  discountAmount      Decimal       @default(0) @db.Decimal(12, 2) @map("discount_amount")
  totalAmount         Decimal       @db.Decimal(12, 2) @map("total_amount")
  paymentMethod       String?       @map("payment_method")
  paymentStatus       String        @default("PENDING") @map("payment_status")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  customer         CustomerProfile  @relation(fields: [customerId], references: [id])
  provider         ProviderProfile? @relation("BookingProvider", fields: [providerId], references: [id])
  assignedProvider ProviderProfile? @relation("BookingAssignedProvider", fields: [assignedProviderId], references: [id])
  items            BookingItem[]
  location         BookingLocation?
  payment          Payment?
  review           Review?
  cashLedgerEntry  CashLedgerEntry?
  cashPaymentDetail CashPaymentDetail?

  @@map("bookings")
  @@index([customerId])
  @@index([providerId])
  @@index([businessUnitId])
  @@index([status])
  @@index([scheduledStart])
}

enum BookingType {
  STANDARD
  CUSTOM
}

enum BookingStatus {
  DRAFT
  PENDING
  ACCEPTED
  CONFIRMED
  PAYMENT_PENDING
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DECLINED
  REFUNDED
  DISPUTED
}

model BookingItem {
  id                         String   @id @default(cuid())
  bookingId                  String   @map("booking_id")
  serviceId                  String   @map("service_id")
  serviceNameSnapshot        String   @map("service_name_snapshot")
  serviceDescriptionSnapshot String?  @map("service_description_snapshot") @db.Text
  unitPrice                  Decimal  @db.Decimal(12, 2) @map("unit_price")
  quantity                   Int      @default(1)
  durationMinutes            Int      @map("duration_minutes")
  lineTotal                  Decimal  @db.Decimal(12, 2) @map("line_total")
  createdAt                  DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_items")
  @@index([bookingId])
}

model BookingLocation {
  id           String   @id @default(cuid())
  bookingId    String   @unique @map("booking_id")
  locationType String   @map("location_type")
  addressLine1 String?  @map("address_line_1")
  city         String?
  province     String?
  postalCode   String?  @map("postal_code")
  country      String?  @default("ZA")
  latitude     Float
  longitude    Float
  createdAt    DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_locations")
}

// ── Payments / Finance ──────────────────────────────────────────

model Payment {
  id                         String    @id @default(cuid())
  uuid                       String    @unique @default(uuid())
  bookingId                  String    @unique @map("booking_id")
  customerId                 String    @map("customer_id")
  providerId                 String?   @map("provider_id")
  businessUnitId             String?   @map("business_unit_id")
  amount                     Decimal   @db.Decimal(12, 2)
  currency                   String    @default("ZAR")
  gateway                    String    @default("paystack") // paystack, manual_cash, manual_eft
  method                     String    // waasha_payment, cash, eft
  status                     String    @default("PENDING") // PENDING, PROCESSING, PAID, FAILED, CANCELLED, REFUNDED
  commissionRate             Decimal?  @db.Decimal(5,2) @map("commission_rate")
  commissionAmount           Decimal?  @db.Decimal(12,2) @map("commission_amount")
  // Slice 4 — provider abstraction + idempotency + webhook reconciliation
  idempotencyKey             String?   @unique @map("idempotency_key")
  gatewayTransactionId       String?   @map("gateway_transaction_id")
  gatewayResponseReference   String?   @map("gateway_response_reference")
  providerReference          String?   @map("provider_reference")
  internalReference          String?   @map("internal_reference")
  initiatedAt                DateTime? @map("initiated_at")
  paidAt                     DateTime? @map("paid_at")
  failedAt                   DateTime? @map("failed_at")
  refundedAt                 DateTime? @map("refunded_at")
  failureReason              String?   @db.Text @map("failure_reason")
  metadata                   Json?     @map("metadata")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  booking Booking        @relation(fields: [bookingId], references: [id])
  events  PaymentEvent[]

  @@map("payments")
  @@index([bookingId])
  @@index([status])
  @@index([customerId])
  @@index([providerId])
  @@index([idempotencyKey])
  @@index([gatewayTransactionId])
}

model PaymentEvent {
  id               String   @id @default(cuid())
  paymentId        String   @map("payment_id")
  eventType        String   @map("event_type")
  gatewayEventId   String?  @unique @map("gateway_event_id")
  payload          Json?    @map("payload_json")
  processingStatus String   @default("PROCESSED") @map("processing_status") // PROCESSED, DUPLICATE, FAILED
  createdAt        DateTime @default(now()) @map("created_at")
  processedAt      DateTime? @map("processed_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_events")
  @@index([paymentId])
  @@index([gatewayEventId])
  @@index([eventType])
}

model CashPaymentDetail {
  id                  String    @id @default(cuid())
  bookingId           String    @unique @map("booking_id")
  changeRequested     Boolean   @default(false) @map("change_requested")
  amountTendered      Decimal?  @db.Decimal(12,2) @map("amount_tendered")
  changeAmount        Decimal?  @db.Decimal(12,2) @map("change_amount")
  providerNotifiedAt  DateTime? @map("provider_notified_at")
  confirmedByProviderAt DateTime? @map("confirmed_by_provider_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("cash_payment_details")
  @@index([bookingId])
}

// ── Reviews ─────────────────────────────────────────────────────

model Review {
  id          String   @id @default(cuid())
  uuid        String   @unique @default(uuid())
  bookingId   String   @unique @map("booking_id")
  customerId  String   @map("customer_id")
  providerId  String?  @map("provider_id")
  rating      Int
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("reviews")
  @@index([providerId])
}

// ── Cash Settlement Ledger (Phase 1.5) ────────────────────────

model ProviderCashAccount {
  id                    String   @id @default(cuid())
  providerId            String   @unique @map("provider_id")
  outstandingCommission Decimal  @default(0) @db.Decimal(12,2) @map("outstanding_commission")
  totalCashGross        Decimal  @default(0) @db.Decimal(12,2) @map("total_cash_gross")
  totalCashCommission   Decimal  @default(0) @db.Decimal(12,2) @map("total_cash_commission")
  totalSettled          Decimal  @default(0) @db.Decimal(12,2) @map("total_settled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_cash_accounts")
  @@index([providerId])
}

model CashLedgerEntry {
  id               String   @id @default(cuid())
  providerId       String   @map("provider_id")
  bookingId        String?  @unique @map("booking_id")
  grossAmount      Decimal  @db.Decimal(12,2) @map("gross_amount")
  paymentMethod    String   @map("payment_method")
  commissionRate   Decimal  @db.Decimal(5,2) @map("commission_rate")
  commissionAmount Decimal  @db.Decimal(12,2) @map("commission_amount")
  type             String   @map("type") // ACCRUAL, SETTLEMENT, REVERSAL, ADJUSTMENT
  currency         String   @default("ZAR") @map("currency")
  idempotencyKey   String?  @unique @map("idempotency_key")
  createdAt        DateTime @default(now()) @map("created_at")
  metadata         Json?    @map("metadata")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  booking  Booking?        @relation(fields: [bookingId], references: [id])

  @@map("cash_ledger_entries")
  @@index([providerId])
  @@index([bookingId])
  @@index([type])
  @@index([createdAt])
  @@index([idempotencyKey])
}

// ── Admin / Configuration ───────────────────────────────────────

model AdminSetting {
  id          String   @id @default(cuid())
  settingKey  String   @unique @map("setting_key")
  settingValue String  @map("setting_value") @db.Text
  valueType   String   @default("STRING") @map("value_type") // STRING, NUMBER, JSON, BOOLEAN
  description String?  @db.Text
  isSensitive Boolean  @default(false) @map("is_sensitive")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("admin_settings")
  @@index([settingKey])
}

// ── Notifications (Slice 7 — provider-agnostic, IN_APP primary) ───────
// Blueprint §39/§40. Domain emits intents; delivery adapters plug in later.
// No vendor SDK is referenced here. No secrets or precise locations stored.

model Notification {
  id              String    @id @default(cuid())
  recipientUserId String    @map("user_id")
  audience        String    @default("CUSTOMER") // CUSTOMER | PROVIDER — deep-link routing only
  type            String    // BOOKING_CREATED, NEW_BOOKING_REQUEST, BOOKING_ACCEPTED, ...
  channel         String    @default("IN_APP") // IN_APP | PUSH | EMAIL | SMS | WHATSAPP
  status          String    @default("UNREAD") // UNREAD | READ
  title           String
  message         String    @db.Text // plain text only — never rendered as HTML
  entityType      String?   @map("entity_type")
  entityId        String?   @map("entity_id")
  eventKey        String?   @unique @map("event_key") // idempotency: booking:<id>:status:<S>, payment:<id>:<event>
  metadata        Json?     @map("metadata")
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("notifications")
  @@index([recipientUserId, status, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([eventKey])
  @@index([entityType, entityId])
}

model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  channel          String   @default("IN_APP")
  notificationType String   @map("notification_type") // BOOKING_UPDATES | PAYMENT_UPDATES | MARKETING
  isEnabled        Boolean  @default(true) @map("is_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, channel, notificationType])
  @@map("notification_preferences")
  @@index([userId])
}

// ── Media & File Storage (Slice 11) ─────────────────────────────────
// Blueprint Document 12. MySQL stores metadata/relationships only — never
// raw binary. Object bytes live in provider-agnostic object storage behind
// the StorageProvider interface (backend/src/infrastructure/storage).
// Lifecycle: PENDING_UPLOAD → UPLOADED → ACTIVE; failure/cleanup states
// REJECTED / FAILED / DELETED. Only ACTIVE assets may be attached or
// served as public images.

model MediaAsset {
  id               String    @id @default(cuid())
  uuid             String    @unique @default(uuid())
  ownerType        String    @map("owner_type") // PROVIDER | CUSTOMER | ADMIN
  ownerId          String    @map("owner_id") // provider profile id or user id — always server-derived
  tenantId         String?   @map("tenant_id")
  purpose          String    @map("purpose") // PROFILE | SERVICE | PORTFOLIO | CUSTOM_REQUEST | BUSINESS | VERIFICATION
  targetId         String?   @map("target_id") // service id / custom-request id where applicable
  storageKey       String    @unique @map("storage_key") // server-generated namespaced key, never client-supplied
  originalFilename String?   @map("original_filename")
  mimeType         String    @map("mime_type")
  detectedMimeType String?   @map("detected_mime_type")
  extension        String?
  sizeBytes        Int       @map("size_bytes")
  checksum         String?
  width            Int?
  height           Int?
  visibility       String    @default("PUBLIC") @map("visibility") // PUBLIC | PRIVATE
  moderationStatus String    @default("PENDING") @map("moderation_status") // PENDING | APPROVED | REJECTED | NEEDS_REVIEW | HIDDEN
  status           String    @default("PENDING_UPLOAD") @map("status") // PENDING_UPLOAD | UPLOADED | ACTIVE | REJECTED | FAILED | DELETED
  createdBy        String    @map("created_by") // uploader user id — server-derived
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@map("media_assets")
  @@index([ownerType, ownerId])
  @@index([purpose, targetId])
  @@index([status])
  @@index([storageKey])
  @@index([createdBy])
}

// ── POS & Inventory (Slice 14) ────────────────────────────────────────
// Provider/business operational tooling. A POS sale is NOT a booking: it
// never creates bookings, never completes bookings, and never writes
// Payment/CashLedgerEntry rows (payment records stay booking-scoped).
// Commission treatment for POS is DEFERRED to the finance/admin slice:
// pos_sales carries an informational commission quote (commissionEligible
// is always false in this slice) — never authoritative settlement.
// Inventory quantities are server-authoritative; every change is traced
// through inventory_movements with the resulting balance preserved.

model InventoryItem {
  id                String    @id @default(cuid())
  uuid              String    @unique @default(uuid())
  providerId        String    @map("provider_id") // owning provider profile id — server-derived
  businessUnitId    String?   @map("business_unit_id") // T3 unit scope where applicable
  sku               String?   // unique per provider where set
  name              String
  description       String?   @db.Text
  unit              String    @default("unit")
  costPrice         Decimal   @default(0) @db.Decimal(12, 2) @map("cost_price")
  sellingPrice      Decimal   @db.Decimal(12, 2) @map("selling_price")
  currency          String    @default("ZAR")
  quantityOnHand    Int       @default(0) @map("quantity_on_hand")
  lowStockThreshold Int       @default(0) @map("low_stock_threshold")
  isActive          Boolean   @default(true) @map("is_active")
  imageUrl          String?   @map("image_url") // reference only — uploads stay behind the Slice 11 media abstraction
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  movements InventoryMovement[]
  saleLines PosSaleLine[]

  @@map("inventory_items")
  @@index([providerId])
  @@index([businessUnitId])
  @@index([providerId, isActive])
  @@index([providerId, sku])
  @@index([isActive])
  @@index([updatedAt])
}

model InventoryMovement {
  id                String   @id @default(cuid())
  itemId            String   @map("item_id")
  providerId        String   @map("provider_id") // tenant scope snapshot — server-derived
  businessUnitId    String?  @map("business_unit_id")
  movementType      String   @map("movement_type") // RECEIVED | ADJUST_INCREASE | ADJUST_DECREASE | SALE | RETURN | REVERSAL
  quantityDelta     Int      @map("quantity_delta") // signed: +in / −out
  resultingQuantity Int      @map("resulting_quantity") // balance after applying delta
  actorUserId       String   @map("actor_user_id")
  referenceType     String?  @map("reference_type") // POS_SALE | MANUAL | REVERSAL
  referenceId       String?  @map("reference_id")
  reason            String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("inventory_movements")
  @@index([itemId, createdAt])
  @@index([providerId, createdAt])
  @@index([movementType])
  @@index([referenceType, referenceId])
}

model PosSale {
  id               String   @id @default(cuid())
  uuid             String   @unique @default(uuid())
  providerId       String   @map("provider_id") // owning provider profile id — server-derived
  businessUnitId   String?  @map("business_unit_id")
  status           String   @default("COMPLETED") @map("status") // COMPLETED | REVERSED
  paymentMethod    String   @map("payment_method") // cash | eft | waasha_payment
  paymentStatus    String   @default("PAID") @map("payment_status") // PAID | PENDING
  currency         String   @default("ZAR")
  subtotal         Decimal  @db.Decimal(12, 2)
  totalAmount      Decimal  @db.Decimal(12, 2) @map("total_amount")
  // Informational commission quote only (Slice 14: NOT settlement — see header).
  commissionRate   Decimal? @db.Decimal(5, 2) @map("commission_rate")
  commissionAmount Decimal? @db.Decimal(12, 2) @map("commission_amount")
  commissionEligible Boolean @default(false) @map("commission_eligible")
  idempotencyKey   String?  @unique @map("idempotency_key")
  note             String?  @db.Text
  createdBy        String   @map("created_by") // actor user id — server-derived
  reversedAt       DateTime? @map("reversed_at")
  reversalReason   String?  @map("reversal_reason") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  lines PosSaleLine[]

  @@map("pos_sales")
  @@index([providerId, createdAt])
  @@index([businessUnitId, createdAt])
  @@index([status])
  @@index([paymentMethod])
  @@index([idempotencyKey])
}

model PosSaleLine {
  id              String  @id @default(cuid())
  saleId          String  @map("sale_id")
  lineType        String  @map("line_type") // SERVICE | PRODUCT
  serviceId       String? @map("service_id")
  inventoryItemId String? @map("inventory_item_id")
  nameSnapshot    String  @map("name_snapshot") // historical price/name — never recalculated
  unitPrice       Decimal @db.Decimal(12, 2) @map("unit_price")
  quantity        Int
  lineTotal       Decimal @db.Decimal(12, 2) @map("line_total")
  createdAt       DateTime @default(now()) @map("created_at")

  sale PosSale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@map("pos_sale_lines")
  @@index([saleId])
  @@index([serviceId])
  @@index([inventoryItemId])
}

// ── Training-Centre Ecosystem (Slice 17) ────────────────────────────
// Blueprint Documents 01/05/06 + §§30–31/36–38/42. Partners recruit
// students/graduates and may accrue a *configured* allocation taken from
// the platform commission on *eligible completed services only* — never
// for registration, approval, booking creation, payment alone, cancelled
// or declined bookings. Attribution is historical and never deleted when
// a partner is deactivated. Partner affiliation never affects
// marketplace ranking (enforced by absence of any ranking coupling here).
// Payout rails are deferred: accruals are ledger records (ACCRUED), not
// payments; no model here implies money moved.

model TrainingPartner {
  id                 String   @id @default(cuid())
  uuid               String   @unique @default(uuid())
  legalName          String   @map("legal_name")
  displayName        String   @map("display_name")
  description        String?  @db.Text
  institutionType    String   @map("institution_type") // COLLEGE | ACADEMY | TRAINING_CENTRE | UNIVERSITY | NGO | OTHER
  contactEmail       String?  @map("contact_email")
  contactPhone       String?  @map("contact_phone")
  website            String?
  addressLine1       String?  @map("address_line_1")
  city               String?
  province           String?
  postalCode         String?  @map("postal_code")
  country            String?  @default("ZA")
  categoriesServed   Json?    @map("categories_served") // subset of the 5 launch category codes
  logoUrl            String?  @map("logo_url") // reference only — uploads stay behind the Slice 11 media abstraction
  status             String   @default("PENDING") @map("status") // PENDING | ACTIVE | SUSPENDED | DEACTIVATED
  verificationStatus String   @default("UNVERIFIED") @map("verification_status") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  partnershipNotes   String?  @map("partnership_notes") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  members     TrainingPartnerMember[]
  referrals   TrainingReferral[]
  attributions TrainingAttribution[]
  evidence    TrainingEvidence[]
  shareRules  PartnerShareRule[]
  accruals    PartnerAccrual[]

  @@map("training_partners")
  @@index([status])
  @@index([verificationStatus])
  @@index([institutionType])
}

model TrainingPartnerMember {
  id        String   @id @default(cuid())
  partnerId String   @map("partner_id")
  userId    String   @map("user_id")
  role      String   @default("STAFF") @map("role") // OWNER | MANAGER | STAFF
  status    String   @default("ACTIVE") @map("status") // ACTIVE | SUSPENDED | REMOVED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partner TrainingPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
  @@map("training_centre_users")
  @@index([userId])
  @@index([partnerId, status])
}

model TrainingReferral {
  id              String    @id @default(cuid())
  partnerId       String    @map("partner_id")
  codeHash        String    @unique @map("code_hash") // SHA-256 of the random code; raw code returned once, never stored/logged
  codePrefix      String    @map("code_prefix") // first 6 chars — non-secret lookup aid only
  invitedEmail    String?   @map("invited_email")
  invitedPhone    String?   @map("invited_phone")
  programme       String?
  status          String    @default("PENDING") @map("status") // PENDING | CLAIMED | EXPIRED | REVOKED
  expiresAt       DateTime  @map("expires_at")
  createdBy       String    @map("created_by") // partner member user id — server-derived
  claimedByUserId String?   @map("claimed_by_user_id")
  claimedAt       DateTime? @map("claimed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  partner TrainingPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("training_referrals")
  @@index([partnerId, status])
  @@index([status, expiresAt])
  @@index([claimedByUserId])
}

model TrainingAttribution {
  id             String    @id @default(cuid())
  partnerId      String    @map("partner_id")
  providerId     String    @map("provider_id")
  referredUserId  String?   @map("referred_user_id")
  referralId     String?   @map("referral_id")
  source         String    @map("source") // REFERRAL_CODE | ADMIN_ATTRIBUTION | EVIDENCE_LINKED
  status         String    @default("ACTIVE") @map("status") // ACTIVE | ENDED
  referredAt     DateTime  @default(now()) @map("referred_at")
  approvedAt     DateTime? @map("approved_at")
  endedAt        DateTime? @map("ended_at")
  endedReason    String?   @map("ended_reason") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  partner TrainingPartner @relation(fields: [partnerId], references: [id])

  // A provider may hold rows for different partners over time (history is
  // retained), but only one ACTIVE row is permitted — enforced
  // transactionally in the service layer. The pair unique blocks duplicate
  // attribution of the same provider to the same partner.
  @@unique([partnerId, providerId])
  @@map("training_centre_providers")
  @@index([partnerId, status])
  @@index([providerId, status])
  @@index([referralId])
}

model TrainingEvidence {
  id                     String    @id @default(cuid())
  partnerId              String    @map("partner_id")
  providerId             String    @map("provider_id")
  attributionId          String?   @map("attribution_id")
  programme              String?
  qualificationReference String?   @map("qualification_reference")
  institutionConfirmation String?  @map("institution_confirmation") @db.Text
  completionDate         DateTime? @map("completion_date") @db.Date
  mediaAssetId           String?   @map("media_asset_id") // Slice 11 media asset reference — never raw bytes
  status                 String    @default("SUBMITTED") @map("status") // SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED
  submittedBy            String    @map("submitted_by") // server-derived user id
  reviewedBy             String?   @map("reviewed_by")
  reviewedAt             DateTime? @map("reviewed_at")
  reviewNote             String?   @map("review_note") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  partner TrainingPartner @relation(fields: [partnerId], references: [id])

  @@map("training_evidence")
  @@index([partnerId, status])
  @@index([providerId])
  @@index([attributionId])
  @@index([mediaAssetId])
}

model PartnerShareRule {
  id           String    @id @default(cuid())
  scope        String    @map("scope") // GLOBAL | PARTNER | PROGRAMME
  partnerId    String?   @map("partner_id")
  programme    String?
  percent      Decimal   @db.Decimal(5, 2) // % of the platform commission allocated to the partner
  currency     String    @default("ZAR")
  isActive     Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime @default(now()) @map("effective_from")
  effectiveTo  DateTime? @map("effective_to")
  createdBy    String    @map("created_by") // admin user id — server-derived
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  partner TrainingPartner? @relation(fields: [partnerId], references: [id])

  @@map("partner_share_rules")
  @@index([scope, isActive])
  @@index([partnerId, isActive])
  @@index([isActive, effectiveFrom])
}

model PartnerAccrual {
  id               String   @id @default(cuid())
  partnerId        String   @map("partner_id")
  providerId       String   @map("provider_id")
  bookingId        String   @unique @map("booking_id") // one accrual per eligible booking — duplicate-safe
  paymentId        String?  @map("payment_id")
  grossAmount      Decimal  @db.Decimal(12, 2) @map("gross_amount")
  commissionRate   Decimal? @db.Decimal(5, 2) @map("commission_rate") // platform commission snapshot (%)
  commissionAmount Decimal? @db.Decimal(12, 2) @map("commission_amount") // platform commission snapshot (ZAR)
  partnerPercent   Decimal  @db.Decimal(5, 2) @map("partner_percent") // applied rule snapshot (% of commission)
  partnerAmount    Decimal  @db.Decimal(12, 2) @map("partner_amount") // accrued allocation snapshot (ZAR)
  currency         String   @default("ZAR")
  ruleId           String?  @map("rule_id") // applied rule snapshot reference
  status           String   @default("ACCRUED") @map("status") // ACCRUED | REVERSED
  idempotencyKey   String?  @unique @map("idempotency_key")
  earnedAt         DateTime @default(now()) @map("earned_at")
  paidAt           DateTime? @map("paid_at") // deferred payout rails: stays null until a real payout mechanism exists
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  partner TrainingPartner @relation(fields: [partnerId], references: [id])

  @@map("training_centre_earnings")
  @@index([partnerId, status, earnedAt])
  @@index([providerId])
  @@index([bookingId])
  @@index([status])
}

// ── Audit ───────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?  @map("actor_user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  beforeJson   Json?    @map("before_json")
  afterJson    Json?    @map("after_json")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@map("audit_logs")
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}
